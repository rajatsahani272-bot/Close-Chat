@'
# Dependencies
node_modules/
**/node_modules/

# Environment variables and secrets
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Build output
dist/
build/
coverage/

# Frontend backups
frontend/backup-complete-ui-20261021-005659/
frontend/backup-mui-20261021-004942/
frontend/backup-ui-20261021-004228/

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# IDE and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.bak
'@ | Set-Content .gitignore -Encoding utf8